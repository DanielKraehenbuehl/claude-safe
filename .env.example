# Leave empty to use web-based login (recommended)
ANTHROPIC_API_KEY=

# Optional: Set your project directory
# PROJECT_DIR=/path/to/your/project

# Optional: Claude Code version (default: latest)
# CLAUDE_CODE_VERSION=latest

# Optional: Your timezone (default: America/Los_Angeles)
# TZ=America/New_York

# Optional: get-shit-done default model (sonnet, opus, or haiku)
# GSD_DEFAULT_MODEL=sonnet

# Optional: For git worktrees, path to the main repository (auto-detected if not set)
# Use WSL-style paths (/mnt/d/...) not Windows paths (D:/...) to avoid colon conflicts
# GIT_PARENT_REPO=/mnt/d/doc/git/my-main-repo
